# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/legalerrand

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Railway: ${{Redis.REDIS_URL}}  (private network; provision the Redis template in the same project)
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_here
JWT_REFRESH_EXPIRES_IN=30d

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=legalerrand-documents

# ─── DeepSeek AI (OpenAI-compatible — swap baseURL to migrate to Mistral) ─────
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── Rate Limits ──────────────────────────────────────────────────────────────
FREE_AI_QUERIES_PER_DAY=10
FREE_RESEARCH_SESSIONS_PER_DAY=5

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# Super admin bootstrap (createSuperAdmin.ts)
SUPER_ADMIN_EMAIL=admin@legalerrand.com
SUPER_ADMIN_PASSWORD=Admin@1234!

# ─── ZeptoMail SMTP (primary — waitlist + OTP emails) ─────────────────────────
# ZeptoMail → Send Mail → SMTP → copy the "password" (send mail token). User is always emailapikey.
ZEPTO_SMTP_HOST=smtp.zeptomail.com
ZEPTO_SMTP_PORT=587
ZEPTO_SMTP_SECURE=false
ZEPTO_SMTP_USER=emailapikey
ZEPTO_SMTP_PASS=your_zeptomail_send_mail_token
ZEPTO_MAIL_FROM=LegalErrand <noreply@legalerrand.com>

# ─── Zoho Mail SMTP (fallback) ────────────────────────────────────────────────
# Create an app-specific password: Zoho Mail → Security → App Passwords
# US: smtp.zoho.com | EU: smtp.zoho.eu | Org/custom domain: smtppro.zoho.com
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=hello@legalerrand.com
ZOHO_SMTP_PASS=your_zoho_app_specific_password
ZOHO_MAIL_FROM=LegalErrand <hello@legalerrand.com>

# ─── Resend (fallback when SMTP fails or is unset) ────────────────────────────
# https://resend.com/api-keys — RESEND_FROM must use a domain verified in Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=LegalErrand <hello@legalerrand.com>

# ─── Google Sign-In ───────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:3000, https://dev-academy.legalerrand.com, https://academy.legalerrand.com, https://dev.legalerrand.com, https://legalerrand.com, https://www.legalerrand.com
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
